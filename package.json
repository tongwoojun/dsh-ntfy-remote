{
  "name": "dsh-ntfy-remote",
  "version": "1.0.0",
  "description": "把每个 DSH 会话桥接到一个 ntfy 话题：手机推送、手机回复、审批与提问中转。",
  "license": "MIT",
  "author": "tongwoojun",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "dsh-plugin",
    "ntfy",
    "notification",
    "push",
    "remote",
    "mobile",
    "approval"
  ],
  "homepage": "https://github.com/tongwoojun/dsh-ntfy-remote#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tongwoojun/dsh-ntfy-remote.git"
  },
  "bugs": {
    "url": "https://github.com/tongwoojun/dsh-ntfy-remote/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "boot3.js",
  "exports": {
    ".": "./boot3.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "boot3.js",
    "main.js",
    "bridge.js",
    "ntfy.js",
    "config.js",
    "topics.js",
    "log.js",
    "routes.js",
    "lib/",
    "probe/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
