{
  "name": "dsh-ntfy-remote",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "把每个 DSH 会话桥接到一个 ntfy 话题：手机推送、手机回复、审批与提问中转。",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "boot3.js",
  "exports": {
    ".": "./boot3.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "boot3.js",
    "main.js",
    "bridge.js",
    "ntfy.js",
    "config.js",
    "topics.js",
    "log.js",
    "routes.js",
    "lib/",
    "probe/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
